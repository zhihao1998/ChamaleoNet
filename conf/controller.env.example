# Shared config for both:
# - ./tsdn-multi.sh
# - ./bfrt_grpc/start_controller.sh
#
# Usage:
#   cp conf/controller.env.example conf/controller.env
#   edit conf/controller.env
#
# Note:
# - This project ignores conf/controller.env in git.
# - You can still override any value at runtime via env vars.

# Shared mode:
#   both        => bloom filter + rules
#   rules-only  => rules only, no bloom updates
TSDN_UPDATE_MODE=rules-only
BFR_UPDATE_MODE=${BFR_UPDATE_MODE:-$TSDN_UPDATE_MODE}

# Shared IPC ring
P4_RULE_SHM_NAME=/p4_rule_ring

# --- tsdn raw egress (optional; override collector/switch MACs from conf/tsdn.interfaces) ---
#TSDN_COLLECTOR_INTF=enp8s0
#TSDN_COLLECTOR_SRC_MAC=52:54:00:33:c4:72
#TSDN_COLLECTOR_DST_MAC=52:54:00:8e:da:c1
#TSDN_SWITCH_DST_MAC=90:2d:77:3f:b5:a2

# Log: unset = use intervals below. debug|daemon = preset at end (overwrites the three log intervals).
# Default recommendation: ~10s one line (tsdn .status + controller status/CSV). Override with *_DEBUG_* / *_DAEMON_*.
#TSDN_LOG_OUTPUT_MODE=debug
#TSDN_LOG_OUTPUT_MODE=daemon

# tsdn stats/status (microseconds); 10000000 = 10s
TSDN_STATS_LOG_SAMPLE_US=10000000

# Controller tunables
BFR_EPOCH_SWITCH_SEC=0.1
BFR_HOT_WINDOW=2
BFR_EPOCH_PRINT_SEC=10
BFR_ENTRY_TTL_MS=5000
BFR_SOCK_PATH=/tmp/p4_controller.sock
BFR_HW_SAMPLE_INTERVAL_MS=10000

# --- Log preset (only when TSDN_LOG_OUTPUT_MODE is set) ---
case "${TSDN_LOG_OUTPUT_MODE:-}" in
debug|verbose)
	TSDN_STATS_LOG_SAMPLE_US="${TSDN_LOG_DEBUG_STATS_US:-500000}"
	BFR_EPOCH_PRINT_SEC="${TSDN_LOG_DEBUG_EPOCH_PRINT_SEC:-0.5}"
	BFR_HW_SAMPLE_INTERVAL_MS="${TSDN_LOG_DEBUG_HW_SAMPLE_MS:-1000}"
	;;
daemon|prod|production|longrun)
	TSDN_STATS_LOG_SAMPLE_US="${TSDN_LOG_DAEMON_STATS_US:-10000000}"
	BFR_EPOCH_PRINT_SEC="${TSDN_LOG_DAEMON_EPOCH_PRINT_SEC:-10}"
	BFR_HW_SAMPLE_INTERVAL_MS="${TSDN_LOG_DAEMON_HW_SAMPLE_MS:-10000}"
	;;
esac
