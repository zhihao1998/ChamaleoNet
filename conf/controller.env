# Shared runtime config used by:
# - ./tsdn-multi.sh
# - ./bfrt_grpc/start_controller.sh

# both | rules-only
# TSDN_UPDATE_MODE=rules-only
TSDN_UPDATE_MODE=both
BFR_UPDATE_MODE=${BFR_UPDATE_MODE:-$TSDN_UPDATE_MODE}

P4_RULE_SHM_NAME=/p4_rule_ring

# unset | debug (verbose) | daemon; when set, the case at the end overrides the three log intervals below
#TSDN_LOG_OUTPUT_MODE=daemon

# tsdn .status/stats CSV + controller status/CSV: one row about every 10s (microseconds)
TSDN_STATS_LOG_SAMPLE_US=10000000
BFR_EPOCH_SWITCH_SEC=1
BFR_HOT_WINDOW=2
BFR_EPOCH_PRINT_SEC=10
BFR_ENTRY_TTL_MS=5000
BFR_SOCK_PATH=/tmp/p4_controller.sock
BFR_INSTALL_BATCH_SIZE=1024
BFR_INSTALL_BATCH_MIN=256
BFR_INSTALL_CALL_TARGET_MS=120
BFR_INSTALL_BACKLOG_BATCHES=12
BFR_INSTALL_BACKLOG_HIGH_WATERMARK=20000
BFR_INSTALL_BUDGET_MS=900
BFR_HW_SAMPLE_INTERVAL_MS=10000
BFR_FAILED_CLEAN_INTERVAL_MS=200
BFR_FAILED_CLEAN_SCAN_BATCH=1024
BFR_IDLE_CLEAN_INTERVAL_MS=200
BFR_IDLE_CLEAN_SKIP_PENDING=4096
# 0: strict batch (throughput first) 1: per-entry fallback after batch failure (success rate first)
BFR_INSTALL_FALLBACK_SINGLE=0

# --- Log output presets (sourced as shell; only when TSDN_LOG_OUTPUT_MODE is set) ---
# Override case defaults: TSDN_LOG_DEBUG_* / TSDN_LOG_DAEMON_* (units match each variable name)
case "${TSDN_LOG_OUTPUT_MODE:-}" in
debug|verbose)
	TSDN_STATS_LOG_SAMPLE_US="${TSDN_LOG_DEBUG_STATS_US:-500000}"
	BFR_EPOCH_PRINT_SEC="${TSDN_LOG_DEBUG_EPOCH_PRINT_SEC:-0.5}"
	BFR_HW_SAMPLE_INTERVAL_MS="${TSDN_LOG_DEBUG_HW_SAMPLE_MS:-1000}"
	;;
daemon|prod|production|longrun)
	TSDN_STATS_LOG_SAMPLE_US="${TSDN_LOG_DAEMON_STATS_US:-10000000}"
	BFR_EPOCH_PRINT_SEC="${TSDN_LOG_DAEMON_EPOCH_PRINT_SEC:-10}"
	BFR_HW_SAMPLE_INTERVAL_MS="${TSDN_LOG_DAEMON_HW_SAMPLE_MS:-10000}"
	;;
esac
